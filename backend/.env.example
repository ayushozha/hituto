# Hi Tuto backend — copy to backend/.env and fill in keys.
# Server loads this file only (not the frontend env).

# --- Local demo ---
FRONTEND_ORIGIN=http://localhost:5173,http://127.0.0.1:5173
AUTH_DISABLED=1
SKIP_PROVIDER_VALIDATION=1
DATABASE_URL=sqlite:///./hituto.db

# --- LLM (Anthropic OpenAI-compatible) ---
# https://platform.claude.com/docs/en/cli-sdks-libraries/libraries/openai-sdk
# Key from https://platform.claude.com/settings/keys
LLM_PROVIDER=openai
LLM_BASE_URL=https://api.anthropic.com/v1
LLM_API_KEY=
# ANTHROPIC_API_KEY=          # alternate name for the same key
LLM_MODEL=claude-sonnet-4-6
COURSEGEN_LLM_MODEL=claude-sonnet-4-6
LLM_MAX_TOKENS=32000
MAX_GEN_RETRIES=2

# A2UI course lessons (off — HTML gen_fragment streaming is the default UX)
COURSEGEN_A2UI_LESSONS=0
GEN_SKELETON_STREAMING=1
GEN_SECTION_FANOUT=1

# --- Auth (Clerk JWKS) ---
CLERK_JWT_ISSUER=https://your-slug.clerk.accounts.dev

# --- Storage (InsForge buckets; auth is Clerk) ---
INSFORGE_BASE_URL=
INSFORGE_API_KEY=
STORAGE_BUCKET=source-documents
MESH_STORAGE_BUCKET=meshes

# --- Optional: web search (exa | youcom) ---
SEARCH_PROVIDER=youcom
YOUCOM_API_KEY=
# EXA_API_KEY=

# --- Images + lesson TTS (OpenAI / ChatGPT) ---
IMAGE_PROVIDER=openai
OPENAI_IMAGE_MODEL=gpt-image-1.5
OPENAI_IMAGE_QUALITY=medium
# OPENAI_IMAGE_API_KEY=        # defaults to OPENAI_API_KEY / OPENAI_REALTIME_API_KEY
OPENAI_TTS_MODEL=gpt-4o-mini-tts
OPENAI_TTS_VOICE=alloy

# --- Optional: voice instructor (OpenAI Realtime) ---
# VOICE_ENABLED=true
# OPENAI_REALTIME_API_KEY=
# OPENAI_REALTIME_MODEL=gpt-realtime-2.1

# --- Optional: 3D meshes ---
# MESH_PROVIDER=tripo
# TRIPO_API_KEY=

# --- Optional: embeddings / RAG ---
# VECTOR_STORE=keyword
# EMBEDDING_PROVIDER=openai
# EMBEDDING_BASE_URL=
# EMBEDDING_API_KEY=
# EMBEDDING_MODEL=
# EMBEDDING_DIM=

# --- Optional: observability ---
# LANGSMITH_TRACING=false
# LANGSMITH_API_KEY=
# LANGSMITH_PROJECT=hituto

# --- Optional: whiteboard viewer ---
# WHITEBOARD_VIEWER_URL=http://localhost:5174
