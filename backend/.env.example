# =========================================================================
# Hi Tuto backend — copy to backend/.env and fill in API keys.
#
# This is the ONLY env file the server loads for FastAPI.
# Frontend InsForge vars live in frontend/.env (see frontend/.env.example).
# Production validates at startup and raises if required keys are missing.
# Tests set SKIP_PROVIDER_VALIDATION=1 and patch fakes in tests/conftest.py.
# =========================================================================

FRONTEND_ORIGIN=http://localhost:5173
# Production — comma-separate to allow both local + deployed frontends:
# FRONTEND_ORIGIN=http://localhost:5173,https://8xdj824y.insforge.site
LLM_PROVIDER=openai
LLM_BASE_URL=https://api.tokenfactory.nebius.com/v1
LLM_API_KEY=
LLM_MODEL=z-ai/glm-5.2-free
# Use 32000+ for full interactive lesson HTML; small values truncate mid-page.
LLM_MAX_TOKENS=32000

# Optional per-agent overrides (fall back to LLM_* above when unset)
# TUTOR_LLM_BASE_URL=
# TUTOR_LLM_API_KEY=
# TUTOR_LLM_MODEL=
# COURSEGEN_LLM_BASE_URL=
# COURSEGEN_LLM_API_KEY=
# Heavy/thinking: Deep Agent orchestrator + researcher (+ LangGraph generate)
# COURSEGEN_LLM_MODEL=moonshotai/kimi-k3
# Surgical Viewer section edits / slash insert (fallback → COURSEGEN → LLM)
# LESSON_EDIT_LLM_BASE_URL=
# LESSON_EDIT_LLM_API_KEY=
# LESSON_EDIT_LLM_MODEL=
# INSIGHTS_LLM_BASE_URL=
# INSIGHTS_LLM_API_KEY=
# INSIGHTS_LLM_MODEL=

# Private personal-learning observability. Metrics and deterministic feedback continue
# to work when the optional agent is disabled or unavailable.
# INSIGHTS_ENABLED=true
# INSIGHTS_AGENT_ENABLED=true
# INSIGHTS_RAW_EVENT_RETENTION_DAYS=90
# INSIGHTS_AGENT_REFRESH_MINUTES=60

# Course-credit metering (GET /billing/usage). Allowances come from the Clerk
# session JWT `pla` claim (see services/billing_plans.py). Env knobs only rename
# the free tier / override free-tier course credits when the JWT has no plan.
# Spend is recorded when generation starts — outline review stays free.
# Fail-open: creation is only blocked at zero remaining when BILLING_ENFORCE is set.
# BILLING_PLAN_NAME=Early Explorer
# BILLING_COURSE_CREDITS=1
# BILLING_ENFORCE=true

# GMI Cloud media — required for audio TTS (lesson /audio route); image fallback
# when IMAGE_PROVIDER=gmi or TOKENROUTER_API_KEY is unset.
GMI_API_KEY=
GMI_MEDIA_BASE_URL=https://console.gmicloud.ai/api/v1/ie/requestqueue/apikey/requests
# Request-queue model id — NOT the OpenAI-compat "gpt-image-2".
GMI_IMAGE_MODEL=gpt-image-2-generate
GMI_TTS_MODEL=inworld-tts-1.5-mini

# TokenRouter image generation (Gemini-style generateContent) — preferred image
# backend; auto-selected once TOKENROUTER_API_KEY is set (IMAGE_PROVIDER=auto).
TOKENROUTER_API_KEY=
# IMAGE_PROVIDER=auto              # auto | tokenrouter | gmi
# TOKENROUTER_BASE_URL=https://api.tokenrouter.com/v1beta/models
# TOKENROUTER_IMAGE_MODEL=bytedance-seed/seedream-5.0-pro
# IMAGE_TIMEOUT_SECONDS=300      # image models can take several minutes under load

# Pixal3D — private image-to-GLB API (called by the backend only)
# PIXAL3D_BASE_URL=
# PIXAL3D_RESOLUTION=1536       # 512 | 1024 | 1536
# PIXAL3D_SEED=0
# PIXAL3D_MANUAL_FOV=-1         # -1 = automatic camera estimate
# PIXAL3D_SKIP_PREPROCESS=false
# PIXAL3D_TEXTURE_SIZE=4096
# PIXAL3D_TIMEOUT_SECONDS=900
# PIXAL3D_BUSY_RETRIES=3
# PIXAL3D_BUSY_RETRY_SECONDS=20
# MESH_PROVIDER=pixal3d

# Hunyuan 3D — legacy self-hosted api_publish.py (image-to-3D under /api/v1)
# MESH_BASE_URL=http://192.241.160.204:8080
# MESH_STEPS=30                 # num_inference_steps (Turbo=5, Fast=10, Standard=30)
# MESH_OCTREE_RESOLUTION=256    # mesh extraction resolution
# MESH_PROVIDER=auto            # auto | pixal3d | selfhosted | tencent | gmi | atlas
# MESH_STUDIO_MAX_HUNYUAN=3     # max Hunyuan calls per studio chapter (rest procedural); 0 = pause Hunyuan
# MESH_STUDIO_FACE_COUNT=1000000 # high-detail Studio GLB budget; Pixal3D maximum is 1M
# Optional Tencent Cloud fallback:
# TENCENTCLOUD_SECRET_ID=
# TENCENTCLOUD_SECRET_KEY=
# TENCENTCLOUD_REGION=ap-singapore
# TENCENT_HUNYUAN_EDITION=rapid  # rapid (cheaper) | pro
# Optional Atlas fallback:
# ATLASCLOUD_API_KEY=
# ATLASCLOUD_BASE_URL=https://api.atlascloud.ai

# Research (build-time web search) — exa | youcom
SEARCH_PROVIDER=youcom
YOUCOM_API_KEY=
EXA_API_KEY=

# Maps: free, no key (Leaflet + OpenStreetMap tile proxy + Nominatim)
MAPS_PROVIDER=osm
OSM_TILE_UPSTREAM=https://tile.openstreetmap.org
NOMINATIM_URL=https://nominatim.openstreetmap.org

# Embeddings for document-grounded courses (required when VECTOR_STORE=pgvector)
EMBEDDING_PROVIDER=openai
EMBEDDING_BASE_URL=https://api.tokenfactory.nebius.com/v1
EMBEDDING_API_KEY=
EMBEDDING_MODEL=Qwen/Qwen3-Embedding-8B
EMBEDDING_DIM=4096

# Semantic retrieval: `keyword` or `pgvector` (pgvector requires EMBEDDING_* above)
VECTOR_STORE=keyword

# RAG / document ingest (rag-context)
# LiteParse → document.md + parse_manifest (default on).
# RAG_LITEPARSE_ENABLED=1
# OCR: auto | true | false. `auto` probes complexity; true may need Tesseract — see docs/RELEASE.md
# RAG_OCR_ENABLED=auto
# RAG_OCR_MIN_CONFIDENCE=0.55
# RAG_PARSE_TIMEOUT_S=120
# RAG_TREE_ENABLED=1
# RAG_TEACHING_MAP_PLANNER=1
# RAG_CHAPTER_EMBED=1
# RAG_ANSWER_CONTEXT_TOKENS=4000
# RAG_SOURCE_UNIT_TOKENS=1200
# RAG_LESSON_CONTEXT_TOKENS=24000
# Soft preference for teaching-map input; clamped by context window − reserve.
# RAG_TREE_FULL_TOKENS=80000
# RAG_TREE_CONTEXT_WINDOW=128000
# RAG_TREE_OUTPUT_RESERVE=8192

# Pipeline
MAX_GEN_RETRIES=2
# Chapter-outline HITL (knobs.review_outline): cap on AI revision rounds per outline.
# Soft bound — direct edit + approve always works. Default 5.
# MAX_OUTLINE_REVISIONS=5

# Persistence (courses/lessons). Leave SQLite for local development.
DATABASE_URL=sqlite:///./hituto.db
# DATABASE_URL=postgresql+psycopg://postgres:<pass>@localhost:5432/hituto


# AUTH_DISABLED=1  # local demo; skip JWT and use user_id=dev

# Excalidraw whiteboard viewer SPA (InsForge frontend or local whiteboard-viewer :5174)
# WHITEBOARD_VIEWER_URL=# same-origin /whiteboard on InsForge deploy

# Voice instructor (FastAPI WebSocket + OpenAI Realtime S2S) — OFF by default.
# With the realtime key unset, /health reports voice.enabled:false and the frontend hides
# the button. Deepgram settings below are legacy/manual-recovery only; the app does not
# automatically fall back to Deepgram.
# VOICE_ENABLED=true
# VOICE_PROVIDER=openai_realtime_s2s
# OPENAI_REALTIME_API_KEY=
# OPENAI_REALTIME_MODEL=gpt-realtime-2.1
# OPENAI_REALTIME_VOICE=verse
# OPENAI_REALTIME_URL=wss://api.openai.com/v1/realtime
# OPENAI_REALTIME_TRANSCRIPTION_MODEL=gpt-realtime-whisper
# VOICE_SAMPLE_RATE=24000
# VOICE_TTS_SAMPLE_RATE=24000
# VOICE_SESSION_MAX_MINUTES=15
# VOICE_IDLE_TIMEOUT_S=60

# Legacy Deepgram cascade (manual recovery only; not active and not a fallback).
# DEEPGRAM_API_KEY=
# DEEPGRAM_STT_MODEL=flux-general-en
# DEEPGRAM_TTS_MODEL=aura-2-thalia-en
# Legacy cascade brain — SEPARATE from course generation (LLM_MODEL above).
# VOICE_LLM_MODEL=nvidia/Nemotron-3-Ultra-550b-a55b
# VOICE_LLM_BASE_URL=        # defaults to LLM_BASE_URL (Nebius)
# VOICE_LLM_API_KEY=         # defaults to LLM_API_KEY
# VOICE_LLM_MAX_TOKENS=1500

# Observability (optional) — LangSmith traces for coursegen / tutor / voice.
# Opt-in only; unset/false means no network calls. Never required to boot the server.
# LANGSMITH_TRACING=true
# LANGSMITH_API_KEY=
# LANGSMITH_PROJECT=hituto
#
# LangSmith Studio (graph UI): `make studio` starts a local Agent Server on :2024,
# then open https://smith.langchain.com/studio/?baseUrl=http://127.0.0.1:2024
# (or your org Studio connect page with that baseUrl). Requires LANGSMITH_API_KEY.
# Safari: use `cd backend && uv run langgraph dev --tunnel` instead.
#
# In the LangSmith UI, filter traces by tag:
#   agent:coursegen  — lesson generation + syllabus planning
#   agent:tutor      — text tutor (POST + SSE stream)
#   agent:voice      — voice instructor LLM / generate_ui
#   agent:rag        — (reserved) document ingest / teaching-map LLM
# Back-compat: GMI_*/NEBIUS_* env names still feed LLM_*/EMBEDDING_* (config.py aliases).

# fast_gen pipeline knobs (specs/fast_gen — all default ON; set =0 to disable)
# GEN_SKELETON_STREAMING=1    # skeleton frame + live fragment streaming into the shell iframe
# GEN_PARALLEL_INTERPRET=1    # plan LLM runs concurrently with web research
# GEN_ASYNC_ASSETS=1          # background 3D mesh with studio late-join (never blocks lessons)
# GEN_SECTION_FANOUT=1        # page lessons author sections as parallel LLM calls
# GEN_SECTION_CONCURRENCY=3   # concurrent section authors per lesson
# COURSEGEN_A2UI_LESSONS=1    # opt-in A2UI lessons + slash catalogue edit (default off)
# SURGICAL_EDIT_ENABLED=1     # section PATCH refine instead of whole-doc (default on)
# GEN_HEDGED_RETRIES=1        # repair attempts race a fresh rewrite; gate picks the winner
# READING_DESIGN_ENABLED=1   # document-grounded lessons as annotated source reading (specs/design_agents)
# Per-stage coursegen tiers (fallback COURSEGEN_<STAGE>_LLM_* -> COURSEGEN_LLM_* -> LLM_*).
# Planning and grounding review are small structured outputs — point them at a fast model:
# COURSEGEN_PLANNER_LLM_MODEL=anthropic/claude-haiku-4.5
# COURSEGEN_REVIEW_LLM_MODEL=anthropic/claude-haiku-4.5

# Clerk — auth (verify @clerk/react session JWTs against Clerk's JWKS, RS256)
# Issuer = Clerk Frontend API origin: https://<slug>.clerk.accounts.dev (dev) or
# https://clerk.yourdomain.com (prod). Find it in Clerk Dashboard → API keys → "Issuer".
CLERK_JWT_ISSUER=https://your-slug.clerk.accounts.dev
# CLERK_JWKS_URL=            # optional override; defaults to {issuer}/.well-known/jwks.json
# CLERK_AUTHORIZED_PARTIES=  # optional; comma-separated allowed origins to check `azp`

# InsForge — storage (REST buckets) + waitlist table (auth is Clerk, above)
INSFORGE_BASE_URL=https://8xdj824y.us-east.insforge.app
INSFORGE_API_KEY=ik_...
STORAGE_BUCKET=source-documents
MESH_STORAGE_BUCKET=meshes
