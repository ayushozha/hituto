# Clerk — auth (required; app throws at boot if unset). Clerk Dashboard → API keys.
VITE_CLERK_PUBLISHABLE_KEY=pk_test_...

# InsForge — waitlist + storage only (auth is Clerk, above)
VITE_INSFORGE_URL=https://8xdj824y.us-east.insforge.app
VITE_INSFORGE_ANON_KEY=

# FastAPI backend (Render in prod). Leave empty for local Vite proxy → localhost:8077.
# Production must point at the hosted API, e.g.:
# VITE_API_BASE_URL=https://your-api.onrender.com
VITE_API_BASE_URL=

# Skip Clerk auth locally and use a synthetic "dev" user (pair with backend AUTH_DISABLED=1).
# VITE_AUTH_DISABLED=1

# Excalidraw whiteboard viewer (same-origin /whiteboard after deploy, or local :5174)
# VITE_WHITEBOARD_VIEWER_URL=
# VITE_WHITEBOARD_VIEWER_URL=http://localhost:5174
