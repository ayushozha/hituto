# Hi Tuto frontend — copy to frontend/.env.local and fill in keys.

# Clerk — required unless VITE_AUTH_DISABLED=1 (Dashboard → API keys)
VITE_CLERK_PUBLISHABLE_KEY=pk_test_...

# InsForge — waitlist + storage only (auth is Clerk)
VITE_INSFORGE_URL=
VITE_INSFORGE_ANON_KEY=

# FastAPI backend. Leave empty for local Vite proxy → localhost:8077.
# VITE_API_BASE_URL=https://your-api.example.com
VITE_API_BASE_URL=

# Local demo: skip Clerk (pair with backend AUTH_DISABLED=1)
# VITE_AUTH_DISABLED=1

# Optional: Excalidraw whiteboard viewer
# VITE_WHITEBOARD_VIEWER_URL=http://localhost:5174
