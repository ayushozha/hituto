# Fireworks serverless inference. Keep this key on the backend.
LLM_API_KEY=
OPENAI_MODEL=accounts/fireworks/models/deepseek-v4-flash-0731
VISION_MODEL=accounts/fireworks/models/qwen3p7-plus
LLM_BASE_URL=https://api.fireworks.ai/inference/v1

# Deepgram. This key remains on the backend.
DEEPGRAM_API_KEY=
DEEPGRAM_TTS_MODEL=aura-2-thalia-en

# Browser origin allowed to call the FastAPI backend.
APP_ORIGIN=http://localhost:5173

# SQLite path. The default is backend/data/sat_tutor.db.
SAT_TUTOR_DB=backend/data/sat_tutor.db
# Set true only when the API is served over HTTPS.
COOKIE_SECURE=false

# Per-browser-session ceilings. A lesson costs four to six provider calls.
DAILY_LESSON_LIMIT=40
DAILY_CHECK_LIMIT=80
BURST_LIMIT=8
