# Fireworks serverless inference. Keep this key on the backend.
LLM_API_KEY=
OPENAI_MODEL=accounts/fireworks/models/deepseek-v4-flash-0731
VISION_MODEL=accounts/fireworks/models/qwen3p7-plus
LLM_BASE_URL=https://api.fireworks.ai/inference/v1

# Deepgram. This key remains on the backend.
DEEPGRAM_API_KEY=
DEEPGRAM_TTS_MODEL=aura-2-thalia-en

# Browser origin allowed to call the Reboot backend.
APP_ORIGIN=http://localhost:5173

# Production sign-in. Leave OAUTH_PROVIDER unset to keep the development
# account picker; `rbt serve` then refuses to start, which is deliberate.
# One of: google, github, auth0, ory. Register
# <APP_ORIGIN>/__/oauth/callback as the redirect URI with the provider.
OAUTH_PROVIDER=
OAUTH_CLIENT_ID=
OAUTH_CLIENT_SECRET=
# Auth0 and Ory only (the tenant, e.g. tenant.eu.auth0.com).
OAUTH_DOMAIN=
